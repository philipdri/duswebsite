# Database connection string from Neon (https://neon.tech)
# Copy this from your Neon project → Connection Details
# Include ?sslmode=require at the end
DATABASE_URL="postgresql://user:password@ep-example-123456.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# If you used the Neon Vercel integration, this is the direct (unpooled) connection
# string. It is used by Prisma for migrations. Leave empty if you set up manually.
DATABASE_URL_UNPOOLED=""

# Password for the admin panel at /admin/login
# Choose a strong password (16+ characters recommended)
ADMIN_PASSWORD="choose-a-strong-password-here"

# Secret key for signing admin login sessions (JWT)
# Generate with: openssl rand -base64 32
# Or use: https://generate-secret.vercel.app/32
ADMIN_SESSION_SECRET="your-random-32-character-secret-string-here"
