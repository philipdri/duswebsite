# PostgreSQL connection string.
# For Neon (recommended): copy the connection string from your Neon dashboard — it looks like:
#   postgresql://neondb_owner:<password>@ep-xxx-yyy.region.aws.neon.tech/neondb?sslmode=require
# For local dev:           postgresql://user:password@localhost:5432/duswebsite
DATABASE_URL="postgresql://user:password@localhost:5432/duswebsite"

# Password for the /admin panel login
ADMIN_PASSWORD="your-secure-admin-password"

# Random secret used to sign admin session JWTs — at least 32 characters.
# Generate one with: openssl rand -base64 32
ADMIN_SESSION_SECRET="your-random-32-char-secret-string"
